{
  "version": "2.0.0",
  "updated_at": "2026-07-08T09:00:00Z",
  "sync": {
    "min_validation_file_version_allowed": "3.0.0",
    "force_validation_file_update": false,
    "apply_policy": "next_launch"
  },
  "patterns": {
    "phone_e164": {
      "regex": "^\\+[1-9]\\d{7,14}$"
    },
    "phone_digits": {
      "regex": "^[0-9]{9,15}$",
      "extra": [
        "not_prefix_00",
        "not_all_zeros"
      ]
    },
    "email_standard": {
      "regex": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "ssn_14": {
      "regex": "^[0-9]{14}$"
    },
    "name_letters": {
      "regex": "^[\\u0600-\\u06FFa-zA-Z\\s]{2,50}$"
    },
    "doc_14_digits": {
      "regex": "^[0-9]{14}$"
    }
  },
  "error_codes": {
    "AUTH_001": {
      "en": "Invalid identifier or password",
      "ar": ""
    },
    "AUTH_002": {
      "en": "Access token missing, malformed, or expired",
      "ar": ""
    }
  },
  "messages": {
    "required": {
      "en": "This field is required",
      "ar": "هذا الحقل مطلوب",
      "it": "Questo campo è obbligatorio"
    },
    "regex": {
      "en": "Invalid format",
      "ar": "صيغة غير صحيحة",
      "it": "Formato non valido"
    },
    "minLength": {
      "en": "Value is too short",
      "ar": "القيمة قصيرة جداً",
      "it": "Valore troppo corto"
    },
    "maxLength": {
      "en": "Value is too long",
      "ar": "القيمة طويلة جداً",
      "it": "Valore troppo lungo"
    },
    "phone_invalid": {
