      "it": "Inserisci un numero di telefono valido"
    },
    "email_invalid": {
      "en": "Please enter a valid email address",
      "ar": "يرجى إدخال بريد إلكتروني صحيح",
      "it": "Inserisci un indirizzo email valido"
    },
    "ssn_invalid": {
      "en": "National ID must be 14 digits",
      "ar": "يجب أن يكون الرقم القومي 14 رقمًا",
      "it": "Il codice fiscale deve avere 14 cifre"
    },
    "name_invalid": {
      "en": "Name must be 2–50 letters",
      "ar": "يجب أن يكون الاسم من 2 إلى 50 حرفًا",
      "it": "Il nome deve contenere 2–50 lettere"
    },
    "name_letters_only": {
      "en": "Name must contain letters only",
      "ar": "يجب أن يحتوي الاسم على أحرف فقط",
      "it": "Il nome deve contenere solo lettere"
    },
    "name_required_third": {
      "en": "Third name is required",
      "ar": "الاسم الثالث مطلوب",
      "it": "Il terzo nome è obbligatorio"
    },
    "name_required_last": {
      "en": "Last name is required",
      "ar": "اسم العائلة مطلوب",
      "it": "Il cognome è obbligatorio"
    },
    "iqama_invalid": {
      "en": "Iqama number must be 14 digits",
      "ar": "يجب أن يكون رقم الإقامة 14 رقمًا",
      "it": "Il numero Iqama deve avere 14 cifre"
    },
    "visa_invalid": {
      "en": "Visa number must be 14 digits",
      "ar": "يجب أن يكون رقم التأشيرة 14 رقمًا",
      "it": "Il numero del visto deve avere 14 cifre"
    },
    "identifier_14_digits": {
      "en": "Must be 14 digits",
      "ar": "يجب أن يكون 14 رقمًا",
      "it": "Devono essere 14 cifre"
    },
    "residence_required": {
      "en": "Residence ID is required",
      "ar": "رقم الإقامة مطلوب",
      "it": "Il documento di residenza è obbligatorio"
    },
    "password_required": {
      "en": "Password is required",
      "ar": "كلمة المرور مطلوبة",
      "it": "La password è obbligatoria"
    },
    "password_too_short": {
      "en": "Password must be at least {{min}} characters",
      "ar": "يجب أن تكون كلمة المرور {{min}} حرفًا على الأقل",
      "it": "La password deve contenere almeno {{min}} caratteri"
    },
    "password_mixed_case": {
      "en": "Password must include upper and lower case letters",
      "ar": "يجب أن تحتوي كلمة المرور على أحرف كبيرة وصغيرة",
      "it": "La password deve includere lettere maiuscole e minuscole"
    },
    "password_needs_number": {
      "en": "Password must include a number",
      "ar": "يجب أن تحتوي كلمة المرور على رقم",
      "it": "La password deve includere un numero"
    },
    "password_needs_symbol": {
      "en": "Password must include a symbol",
      "ar": "يجب أن تحتوي كلمة المرور على رمز",
      "it": "La password deve includere un simbolo"
    },
    "password_mismatch": {
      "en": "Passwords do not match",
      "ar": "كلمتا المرور غير متطابقتين",
      "it": "Le password non corrispondono"
    },
    "birth_date_invalid": {
      "en": "Birth date must be in the past",
      "ar": "يجب أن يكون تاريخ الميلاد في الماضي",
      "it": "La data di nascita deve essere nel passato"
    },
    "expire_date_invalid": {
      "en": "Expiry date must be in the future",
      "ar": "يجب أن يكون تاريخ الانتهاء في المستقبل",
      "it": "La data di scadenza deve essere nel futuro"
    },
    "gender_required": {
      "en": "Please select a gender",
      "ar": "يرجى اختيار الجنس",
      "it": "Seleziona un genere"
    },
    "mother_name_invalid": {
      "en": "Mother name must be 2–50 letters",
      "ar": "يجب أن يكون اسم الأم من 2 إلى 50 حرفًا",
      "it": "Il nome della madre deve contenere 2–50 lettere"
    }
